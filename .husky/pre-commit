echo "Checking for accidentally staged secrets or test emails..."

. "$(dirname "$0")/secret-pattern.sh"

# Scan staged file CONTENT.
#
# Deliberately not `git diff --cached --name-only -z | xargs -0 grep`: with an
# empty staged set, xargs runs grep with no file arguments, so grep reads stdin
# — which during `git commit -F -` is the commit message — and could reject a
# commit over content that was never staged. A directory rename also puts a
# directory path in --name-only, which grep then errors on.
#
# --diff-filter=ACM skips deletions (nothing left to scan); the -f test skips
# anything that is not a regular file.
FOUND=""
while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "$f" ] || continue
  if grep -qE "$FORBIDDEN_PATTERN" "$f" 2>/dev/null; then
    FOUND="$FOUND  $f
"
  fi
done <<EOF
$(git diff --cached --name-only --diff-filter=ACM)
EOF

if [ -n "$FOUND" ]; then
  echo "🚨 ERROR: Commit rejected — staged file(s) contain a proxy API key (sk_proxy_...) or a private test email:"
  printf '%s' "$FOUND"
  echo "Remove the secrets and stage the changes again."
  echo "If this is a false positive, bypass with: git commit --no-verify"
  exit 1
fi

# Deny-by-default email guard on NEWLY ADDED lines only (existing content is
# grandfathered — this scans the staged diff's additions, not whole files, so
# legacy occurrences don't block unrelated commits).
ADDED_EMAILS=$(git diff --cached --unified=0 --diff-filter=ACM \
  | grep -E '^\+' | grep -vE '^\+\+\+' \
  | scan_disallowed_emails)

if [ -n "$ADDED_EMAILS" ]; then
  echo "🚨 ERROR: Commit rejected — newly added lines contain email address(es) not on the allowlist:"
  printf '  %s\n' $ADDED_EMAILS
  echo "This is a PUBLIC repository. Real addresses (customer, operator, or personal)"
  echo "never belong in commits — use placeholders on example.com, or keep the value"
  echo "in gitignored local config and reference it indirectly."
  echo "If this is genuinely a public address, add it to ALLOWED_EMAIL_REGEX in"
  echo ".husky/secret-pattern.sh in the same commit. Bypass (rarely): git commit --no-verify"
  exit 1
fi

echo "✅ Secret scan passed."
