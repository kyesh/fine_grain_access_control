echo "Checking commit message for secrets..."

. "$(dirname "$0")/secret-pattern.sh"

# A secret pasted into a commit message is as permanent as one committed in a
# file — rewriting published history is the only way to remove it. Scan the
# message with the same pattern the pre-commit hook uses on file content.
#
# $1 is the path to the prepared commit message file.
if grep -qE "$FORBIDDEN_PATTERN" "$1" 2>/dev/null; then
  echo "🚨 ERROR: Commit rejected — the commit message contains a proxy API key (sk_proxy_...) or a private test email."
  echo "Commit messages are permanent. Rewrite the message without the secret."
  echo "If this is a false positive, bypass with: git commit --no-verify"
  exit 1
fi

# Same deny-by-default email guard as pre-commit, applied to the message
# itself (the Co-Authored-By noreply trailer is allowlisted).
MSG_EMAILS=$(scan_disallowed_emails < "$1")
if [ -n "$MSG_EMAILS" ]; then
  echo "🚨 ERROR: Commit rejected — the commit message contains email address(es) not on the allowlist:"
  printf '  %s\n' $MSG_EMAILS
  echo "Commit messages are permanent and this repository is public. Describe the"
  echo "affected account without naming it, or use an example.com placeholder."
  echo "If this is a false positive, bypass with: git commit --no-verify"
  exit 1
fi

echo "✅ Commit message scan passed."
