{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(vercel --prod:*)",
      "Bash(vercel deploy --prod:*)",
      "Bash(npx vercel --prod:*)",
      "Bash(npx vercel deploy --prod:*)",
      "Bash(vercel promote:*)",
      "Bash(npx vercel promote:*)",
      "Bash(vercel alias:*)",
      "Bash(npx vercel alias:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.qa_test_emails.json)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.production)",
      "Write(./.qa_test_emails.json)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production)",
      "Edit(./.qa_test_emails.json)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(vercel env add:*)",
      "Bash(vercel env rm:*)",
      "Bash(npx vercel env add:*)",
      "Bash(npx vercel env rm:*)",
      "Bash(npx vercel cancel:*)",
      "Bash(vercel link:*)",
      "Bash(npx vercel link:*)",
      "Bash(git commit --no-verify:*)"
    ],
    "allow": [
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git push:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run dev:qa:*)",
      "Bash(npm run db:branch:*)",
      "Bash(npm run db:generate:*)",
      "Bash(bash scripts/qa-secrets.sh)",
      "Bash(npx vercel ls:*)",
      "Bash(npx vercel inspect:*)",
      "Bash(npx vercel logs:*)",
      "Bash(npx vercel env ls:*)",
      "Bash(npx vercel env pull:*)",
      "Bash(npx vercel project ls:*)",
      "Bash(npx @playwright/cli:*)",
      "Bash(curl -s http://localhost:9222/json/version)",
      "Bash(curl -sf http://localhost:3000:*)",
      "Bash(npx tsx scripts/cleanup-neon-branches.ts:*)",
      "Bash(bash scripts/cleanup-neon-branches.sh)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-local-env.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-public-content.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-schema-migration.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-migration-file.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-env-check.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-hygiene-check.sh",
            "timeout": 45
          }
        ]
      }
    ]
  }
}
